# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dymgcxar_AI_police_v2?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="1h"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-change-this"
REFRESH_TOKEN_EXPIRATION="7d"

# CORS — comma-separated list of allowed frontend origins
# Use "*" in development or list exact domains in production
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# API
PORT=3001
API_PREFIX="api"
# Python AI Service (FastAPI + LangGraph)
# URL of the Python AI service running locally
PYTHON_AI_SERVICE_URL="http://localhost:8000"